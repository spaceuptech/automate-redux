{
  "name": "automate-redux",
  "version": "2.0.0",
  "description": "A simple library to eliminate reducers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "src": "src",
    "test": "test"
  },
  "scripts": {
    "test": "mocha -r ts-node/register test/**/*.test.ts",
    "init": "mkdir dist",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean && npm run init",
    "build": "tsc",
    "pub": "npm run prebuild && npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://Jayesh333@github.com/spaceuptech/automate-redux.git"
  },
  "keywords": [
    "redux",
    "reducers"
  ],
  "files": [
    "dist"
  ],
  "author": "Jayesh Choudhary",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/spaceuptech/automate-redux/issues"
  },
  "homepage": "https://github.com/spaceuptech/automate-redux#readme",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.1",
    "@types/redux": "^3.6.31",
    "mocha": "^11.7.4",
    "redux": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dot-prop-immutable": "^2.1.1"
  }
}
